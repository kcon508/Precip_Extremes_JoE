# filter(Clip=="Sept_22_clip")%>%
mutate(funct_group=factor(funct_group,levels=c("ANPP","C4","C3.GRASSES","FORB","ANNUALS","TOTAL.GRASSES")))%>%
# filter(funct_group %in% c("C4","C3.GRASSES","FORB","ANNUALS"))%>%
mutate(name.labels=case_when(
funct_group == "C4" ~ "C4 Grass",
funct_group == "C3.GRASSES" ~ "C3 Grass",
funct_group == "FORB" ~ "Forbs",
funct_group == "ANNUALS" ~ "Annuals"))%>%
mutate(name.labels=factor(name.labels,levels=c("C4 Grass","C3 Grass","Annuals","Forbs")))
view(dat.23.avs)
#### 2022 functional groups ####
dat.22.avs<-dat.22.long%>%
group_by(Clip,TRT.2022,TRT.2023,funct_group)%>%
dplyr::summarise(
n.plots=n(),
av=mean(gm2),
sd=sd(gm2),
SE=sd/sqrt(n.plots))%>%
filter(Clip=="Sept_22_clip")%>%
mutate(funct_group=factor(funct_group,levels=c("ANPP","C4","C3.GRASSES","FORB","ANNUALS","TOTAL.GRASSES")))%>%
# filter(funct_group %in% c("C4","C3.GRASSES","FORB","ANNUALS"))%>%
mutate(name.labels=case_when(
funct_group == "C4" ~ "C4 Grass",
funct_group == "C3.GRASSES" ~ "C3 Grass",
funct_group == "FORB" ~ "Forbs",
funct_group == "ANNUALS" ~ "Annuals"))%>%
mutate(name.labels=factor(name.labels,levels=c("C4 Grass","C3 Grass","Annuals","Forbs")))
view(dat.22.avs)
